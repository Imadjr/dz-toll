# Authentication (required for dashboard login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
USER_PASSWORD=change-this-user-password

# Flask and browser access
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
CORS_ORIGINS=http://localhost:3000

# Toll lane configuration
TOLL_LOCATION=Gate A
TOLL_FEE_DA=50
ARDUINO_PORT=COM3
BAUD_RATE=9600
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=360
YOLO_IMAGE_SIZE=320
FRAME_SKIP=4
OCR_INTERVAL=6
RFID_TIMEOUT=7
PLATE_COOLDOWN=10
SHOW_VIDEO=true

# Optional local executable/model overrides
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# MODEL_PATH=C:\path\to\best.pt

# Optional email notifications
ALERT_EMAIL=
SMTP_USER=
SMTP_APP_PWD=
